# ─────────────────────────────────────────────────────────
#   Hidrobart Auth Service — Variables de Entorno
#   Copiar como .env y completar los valores
# ─────────────────────────────────────────────────────────

# App
DEBUG=false
SECRET_KEY=GENERAR_CON_openssl_rand_-hex_32

# ── Azure AD App Registration ──────────────────────────────
# Registrar app en: https://portal.azure.com → Azure AD → App registrations
# Tipo: Web, multi-tenant
AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Para multi-tenant usar "common"; para un solo tenant usar el Tenant ID
AZURE_TENANT_ID=common
AZURE_AUTHORITY=https://login.microsoftonline.com/common
AZURE_REDIRECT_URI=https://login.hidrobart.com/api/auth/callback/azure-ad

# ── Redis (NUEVO dedicado a auth) ─────────────────────────
# Azure Cache for Redis — nuevo recurso para auth sessions
REDIS_HOST=hidrobart-auth-redis.redis.cache.windows.net
REDIS_PORT=6380
REDIS_PASSWORD=TU_REDIS_ACCESS_KEY_AQUI
REDIS_SSL=true
REDIS_DB=0

# ── Dominios permitidos (Hirobart multi-empresa) ──────────
# Lista JSON separada por comas
ALLOWED_DOMAINS=["hidrobart.com","hidrobart.com.mx","hidrobart.com.br"]

# ── CORS Origins ───────────────────────────────────────────
ALLOWED_ORIGINS=["https://login.hidrobart.com","https://portal.hidrobart.com","https://ops.hidrobart.com"]

# ── Base de datos roles (opcional PostgreSQL) ──────────────
DATABASE_URL=postgresql://user:password@localhost/hidrobart_auth
USE_DB_FOR_ROLES=true

# ── Tokens ────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=60
SESSION_TTL_SECONDS=28800
REFRESH_TOKEN_TTL_SECONDS=604800
