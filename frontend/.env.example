# ─────────────────────────────────────────────────────────
#   Hidrobart Login Frontend — Variables de Entorno
#   Copiar como .env.local y completar los valores
# ─────────────────────────────────────────────────────────

# NextAuth
NEXTAUTH_URL=https://login.hidrobart.com
NEXTAUTH_SECRET=GENERAR_CON_openssl_rand_-base64_32

# Azure AD (misma app registration que el backend)
AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# "common" para multi-tenant
AZURE_TENANT_ID=common

# Backend FastAPI URL
NEXT_PUBLIC_AUTH_API=https://auth-api.hidrobart.com
# En desarrollo local:
# NEXT_PUBLIC_AUTH_API=http://localhost:8000

# App info
NEXT_PUBLIC_APP_NAME=Hidrobart
NEXT_PUBLIC_APP_URL=https://login.hidrobart.com
